<style is:global>
    :root {
        --bg: #f5f5f7;
        --surface: #ffffff;
        --ink: #1d1d1f;
        --ink-2: #6e6e73;
        --ink-3: #a1a1a6;
        --line: rgba(0, 0, 0, 0.08);
        --accent: #d97706;
        --accent-soft: #fdf4e4;
        --accent-ink: #8a4b06;
        --radius: 20px;
        --shadow: 0 1px 2px rgba(0, 0, 0, 0.04), 0 18px 40px -20px rgba(0, 0, 0, 0.18);
        --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
            "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", Roboto, sans-serif;
        --font-kai: "Kaiti SC", "STKaiti", "KaiTi", "Songti SC", serif;
    }

    *, *::before, *::after {
        box-sizing: border-box;
    }

    html {
        -webkit-text-size-adjust: 100%;
    }

    body {
        margin: 0;
        height: 100vh;
        min-height: 100dvh;
        display: flex;
        padding: clamp(20px, 5vw, 56px) clamp(16px, 5vw, 40px);
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font-sans),sans-serif;
        font-size: 16px;
        line-height: 1.6;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
    }

    /* 顶部柔光，弱化大面积纯色底 */
    body::before {
        content: "";
        position: fixed;
        top: -30vh;
        left: 50%;
        width: min(140vw, 1100px);
        height: 80vh;
        transform: translateX(-50%);
        background: radial-gradient(50% 50% at 50% 50%, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0) 70%);
        pointer-events: none;
        z-index: 0;
    }

    /* margin:auto 居中：内容超出视口时自动回退为可滚动，不会被裁切 */
    .shell {
        position: relative;
        z-index: 1;
        margin: auto;
        width: 100%;
        max-width: 560px;
        display: flex;
        flex-direction: column;
        gap: clamp(18px, 4vw, 26px);
    }

    .card {
        display: flex;
        height: max(80vh, 500px);
        flex-direction: column;
        align-items: center;
        text-align: center;
        justify-content: center;
        padding: clamp(28px, 7vw, 48px) clamp(22px, 6vw, 46px);
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
    }

    .brand {
        display: grid;
        place-items: center;
        width: 58px;
        height: 58px;
        margin-bottom: 18px;
        border: 1px solid var(--line);
        border-radius: 15px;
        background: var(--bg);
        font-family: var(--font-kai),sans-serif;
        font-size: 31px;
        line-height: 1;
        color: var(--ink);
        animation: float 4s ease-in-out infinite;
    }

    .badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 5px 13px 5px 11px;
        border: 1px solid rgba(217, 119, 6, 0.22);
        border-radius: 999px;
        background: var(--accent-soft);
        color: var(--accent-ink);
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.06em;
    }

    .badge .dot {
        position: relative;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--accent);
    }

    .badge .dot::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 50%;
        background: var(--accent);
        animation: ping 1.9s cubic-bezier(0, 0, 0.2, 1) infinite;
    }

    h1 {
        margin: 18px 0 0;
        font-size: clamp(24px, 6.4vw, 32px);
        font-weight: 700;
        line-height: 1.32;
        letter-spacing: 0.01em;
    }

    .lead {
        margin: 12px 0 0;
        max-width: 34em;
        color: var(--ink-2);
        font-size: clamp(14px, 3.7vw, 15.5px);
        text-wrap: balance;
    }

    .progress {
        width: 100%;
        margin-top: clamp(24px, 6vw, 32px);
    }

    .track {
        height: 6px;
        border-radius: 999px;
        background: #ececf0;
        overflow: hidden;
    }

    .bar {
        width: 40%;
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, #c7c7cc, #1d1d1f);
        animation: slide 2.4s ease-in-out infinite;
        /* 负延迟：首屏即处于运动中，避免停在起点看起来像静止的灰条 */
        animation-delay: -0.7s;
    }

    .progress-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: 10px;
        color: var(--ink-3);
        font-size: 12.5px;
        letter-spacing: 0.02em;
    }

    .progress-meta .d {
        display: inline-block;
        width: 3px;
        height: 3px;
        margin-left: 3px;
        border-radius: 50%;
        background: currentColor;
        animation: blink 1.4s ease-in-out infinite;
    }

    .progress-meta .d:nth-of-type(2) { animation-delay: 0.2s; }
    .progress-meta .d:nth-of-type(3) { animation-delay: 0.4s; }

    .features {
        display: grid;
        gap: 9px;
        width: 100%;
        margin: clamp(24px, 6vw, 30px) 0 0;
        padding: 0;
        list-style: none;
        text-align: left;
    }

    .features li {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 11px 14px;
        border: 1px dashed var(--line);
        border-radius: 12px;
        background: rgba(245, 245, 247, 0.7);
        color: var(--ink-2);
        font-size: 14px;
    }

    .features .mark {
        flex: none;
        width: 13px;
        height: 13px;
        border: 1.5px solid #c7c7cc;
        border-radius: 4px;
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
        width: 100%;
        margin-top: clamp(24px, 6vw, 30px);
    }

    .btn {
        flex: 1 1 150px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 0 18px;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: var(--bg);
        color: var(--ink);
        font-size: 14.5px;
        font-weight: 600;
        text-decoration: none;
        transition: background-color 0.18s ease, transform 0.18s ease;
    }

    .btn:hover {
        background: #ebebef;
    }

    .btn:active {
        transform: scale(0.985);
    }

    .btn-primary {
        border-color: var(--ink);
        background: var(--ink);
        color: #ffffff;
    }

    .btn-primary:hover {
        background: #000000;
    }

    .btn:focus-visible {
        outline: 2px solid var(--ink);
        outline-offset: 2px;
    }

    .foot {
        margin: 0;
        color: var(--ink-3);
        font-size: 12.5px;
        text-align: center;
    }

    @keyframes ping {
        0% { transform: scale(1); opacity: 0.55; }
        70%, 100% { transform: scale(2.6); opacity: 0; }
    }

    @keyframes slide {
        0% { transform: translateX(-100%); }
        100% { transform: translateX(250%); }
    }

    @keyframes blink {
        0%, 100% { opacity: 0.25; }
        50% { opacity: 1; }
    }

    @keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-4px); }
    }

    @media (max-width: 420px) {
        .btn { flex: 1 1 100%; }
        .features li { padding: 10px 12px; font-size: 13.5px; }
    }

    @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
            animation: none !important;
            transition: none !important;
        }
        .bar {
            width: 100%;
            opacity: 0.3;
        }
        .badge .dot::after { opacity: 0; }
    }
</style>
