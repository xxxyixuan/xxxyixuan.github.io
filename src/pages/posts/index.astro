---
import PageLayout from '@layouts/PageLayout.astro'
import PostListItem from '@components/PostListItem.astro'
import type {PostCard} from '@components/PostListItem.astro'
import {getSortedPosts, toCard} from '@src/utils/posts.ts'
import {SITE_NAME} from '@src/config.ts'

/* =================================================================
   文章列表页 —— 首页「全部文章」的落点
   结构：页头（标题 + 总数）→ 按年份分组的文章列表
   ================================================================= */

const pageTitle = `文章 - ${SITE_NAME}`
const pageDescription = '逸瑄的全部文章：技术笔记、踩坑复盘与生活随笔，按发布时间倒序。'

const posts = (await getSortedPosts()).map(toCard)

// 按年份分组：文章多了以后，比平铺一列更好找
const groups: { year: string; items: PostCard[] }[] = []
for (const post of posts) {
  const year = post.date.slice(0, 4)
  const last = groups[groups.length - 1]
  if (last && last.year === year) last.items.push(post)
  else groups.push({year, items: [post]})
}
---

<PageLayout title={pageTitle} description={pageDescription}>
  <div class="posts-page">
    <header class="page-head">
      <h1 class="page-title">文章</h1>
      <p class="page-desc">技术笔记为主，偶尔夹带私货。目前共 {posts.length} 篇。</p>
    </header>

    {
      posts.length === 0 ? (
        <p class="empty">
          还没有发布文章。想先认识我，可以去<a href="/about/">关于页</a>看看。
        </p>
      ) : (
        <div class="groups">
          {
            groups.map((group) => (
              <section class="group" aria-label={`${group.year} 年`}>
                <h2 class="group-year">{group.year}</h2>
                <div class="group-list">
                  {group.items.map((post) => (
                    <PostListItem post={post} variant="featured"/>
                  ))}
                </div>
              </section>
            ))
          }
        </div>
      )
    }
  </div>
</PageLayout>

<style lang="scss">
  /* 断点约定值以 PageLayout :root 的注释为准：md = 768px，sm = 480px */
  $breakpoint-sm: 480px;

  /* 内容宽度：列表页用宽档（引用 PageLayout 的统一变量），并在 main 内居中 */
  $measure: var(--content-wide);

  .posts-page {
    max-width: $measure;
    margin-inline: auto;
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }

  .page-head {
    margin-bottom: clamp(2rem, 5vw, 2.75rem);
  }

  .page-title {
    margin: 0;
    font-size: clamp(1.5rem, 3.6vw, 1.9rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.01em;
    color: var(--text-primary);
  }

  .page-desc {
    margin: 0.7rem 0 0;
    font-size: 0.9rem;
    line-height: 1.8;
    color: var(--text-muted);
  }

  /* ================= 年份分组 ================= */
  .group + .group {
    margin-top: clamp(2rem, 4vw, 2.75rem);
  }

  .group-year {
    margin: 0 0 0.45rem;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: var(--text-primary);
  }

  .group-list {
    display: flex;
    flex-direction: column;
  }

  /* ================= 空状态 ================= */
  .empty {
    margin: 0;
    padding: 2rem 0;
    font-size: 0.9rem;
    line-height: 1.8;
    color: var(--text-muted);

    a {
      color: var(--accent);
      text-decoration: none;

      &:hover,
      &:focus-visible {
        text-decoration: underline;
      }
    }
  }

  @media (max-width: $breakpoint-sm) {
    .page-title {
      font-size: 1.4rem;
    }
  }
</style>
